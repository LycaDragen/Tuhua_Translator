# ============================================
# Tuhua Translator - .gitignore
# ============================================

# ── Node.js ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── pnpm ──
# Note: pnpm-lock.yaml is intentionally NOT ignored.
# For applications (not libraries), lock files should be committed
# to ensure reproducible builds across environments.

# ── Electron Builder ──
dist/
out/

# ── Environment & Secrets ──
.env
.env.local
.env.*.local
*.pem
*.key

# ── OCR / Paddle Models (downloaded at runtime) ──
models/
paddle-models/
*.onnx
*.pth
*.params
*.pdmodel
*.pdiparams

# ── Tesseract traineddata (large, downloaded) ──
tessdata/
*.traineddata

# ── OS Generated Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
Icon?

# ── IDE / Editor ──
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── Logs ──
logs/
*.log

# ── Runtime / Cache ──
cache/
.temp/
.tmp/
*.tmp
*.bak

# ── Test artifacts (large images) ──
test-assets/
test-images/
tests/screenshots/
scripts/ocr-report.json
scripts/context-report.json
scripts/preset-divergence-report.json
scripts/hook-cleaning-report.json
scripts/stdout-decoding-report.json
scripts/ipc-channels-report.json
scripts/glossary-compliance-report.json

# ── Coverage ──
coverage/
.nyc_output/

# ── Electron specific ──
electron-builder.env
