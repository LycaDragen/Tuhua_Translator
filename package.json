{
  "name": "tuhua-translator",
  "version": "3.11.24",
  "description": "Tuhua Translator - Open Source Visual Novel Translator",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "author": {
    "name": "Lyca",
    "email": "sebaguerra6@gmail.com"
  },
  "contributors": [
    {
      "name": "Lyca",
      "email": "sebaguerra6@gmail.com"
    }
  ],
  "license": "CC-BY-NC-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LycaDragen/Tuhua_Translator.git"
  },
  "bugs": {
    "url": "https://github.com/LycaDragen/Tuhua_Translator/issues"
  },
  "homepage": "https://github.com/LycaDragen/Tuhua_Translator#readme",
  "keywords": [
    "visual-novel",
    "translator",
    "ocr",
    "textractor",
    "xuat",
    "deepl",
    "electron",
    "game-translation",
    "japanese",
    "vn"
  ],
  "dependencies": {
    "axios": "^1.7.0",
    "electron-store": "^8.1.0",
    "electron-log": "^5.1.0",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.tuhua.translator",
    "productName": "Tuhua Translator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "renderer/main/assets/Tuhua.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "renderer/main/assets/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "renderer/main/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "LycaDragen",
      "repo": "Tuhua_Translator"
    }
  }
}
