{
  "name": "tuhua-translator",
  "version": "1.0.3",
  "productName": "Tuhua Translator",
  "description": "Tuhua Translator - Open Source Visual Novel Translator",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mac": "electron-builder --mac --arm64 --publish never",
    "build:win:publish": "electron-builder --win --publish always",
    "build:linux:publish": "electron-builder --linux --publish always",
    "rebuild": "electron-builder install-app-deps",
    "test:hook-cleaning": "node scripts/test-hook-cleaning.js",
    "test:stdout-decoding": "node scripts/test-stdout-decoding.js",
    "test:launcher-lifecycle": "node scripts/test-launcher-lifecycle.js",
    "test:ipc-channels": "node scripts/test-ipc-channels.js",
    "test:shortcuts-consistency": "node scripts/test-shortcuts-consistency.js",
    "test:context-memory": "node scripts/test-context-memory.js",
    "test:textractor-connector": "node scripts/test-textractor-connector.js",
    "test:badge-state": "node scripts/test-badge-state.js",
    "test:profile-schema": "node scripts/test-profile-schema.js",
    "test:glossary-merge": "node scripts/test-glossary-merge.js",
    "test:profile-migration": "node scripts/test-profile-migration.js",
    "test:glossary-entries": "node scripts/test-glossary-entries.js",
    "test:llm-base": "node scripts/test-llm-base.js",
    "test:llm-output": "node scripts/test-llm-output.js",
    "test:llm-providers": "node scripts/test-llm-providers.js",
    "test:prompt-template": "node scripts/test-prompt-template.js",
    "test:glossary-prompt": "node scripts/test-glossary-prompt.js",
    "test:glossary-compliance": "node scripts/test-glossary-compliance.js",
    "test:deepl-glossary-sync": "node scripts/test-deepl-glossary-sync.js",
    "test:speaker-extract": "node scripts/test-speaker-extract.js",
    "test:translation-cache": "node scripts/test-translation-cache.js",
    "test:translation-memory": "node scripts/test-translation-memory.js",
    "test:pipeline-abort": "node scripts/test-pipeline-abort.js",
    "test:game-engine-detect": "node scripts/test-game-engine-detect.js",
    "test:ocr-text-cleaning": "node scripts/test-ocr-text-cleaning.js",
    "test:pe-arch": "node scripts/test-pe-arch.js",
    "test:settings-tier-invariant": "node scripts/test-settings-tier-invariant.js",
    "test:game-process-list": "node scripts/test-game-process-list.js",
    "test:textractor-path-detect": "node scripts/test-textractor-path-detect.js",
    "test:game-identity": "node scripts/test-game-identity.js",
    "test:game-inspect": "node scripts/test-game-inspect.js",
    "test:bing-engine": "node scripts/test-bing-engine.js",
    "test:ocr-capture-geometry": "node scripts/test-ocr-capture-geometry.js",
    "test:ocr-engine-switch": "node scripts/test-ocr-engine-switch.js"
  },
  "author": {
    "name": "Lyca",
    "email": "sebaguerra6@gmail.com"
  },
  "contributors": [
    {
      "name": "Lyca",
      "email": "sebaguerra6@gmail.com"
    }
  ],
  "license": "CC-BY-NC-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LycaDragen/Tuhua_Translator.git"
  },
  "bugs": {
    "url": "https://github.com/LycaDragen/Tuhua_Translator/issues"
  },
  "homepage": "https://github.com/LycaDragen/Tuhua_Translator#readme",
  "keywords": [
    "visual-novel",
    "translator",
    "ocr",
    "textractor",
    "xuat",
    "deepl",
    "electron",
    "game-translation",
    "japanese",
    "vn"
  ],
  "dependencies": {
    "axios": "^1.7.0",
    "electron-log": "^5.1.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "tesseract.js": "^5.0.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.tuhua.translator",
    "productName": "Tuhua Translator",
    "directories": {
      "output": "dist"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*/*providers_cuda*",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*/*providers_tensorrt*"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/tesseract.js/**",
      "**/node_modules/tesseract.js-core/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/main/assets/Tuhua.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "renderer/main/assets/icon-1024.png",
      "category": "Utility",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "renderer/main/assets/icon-1024.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "LycaDragen",
      "repo": "Tuhua_Translator",
      "releaseType": "draft"
    }
  }
}
